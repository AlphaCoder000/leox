# Firebase Configuration
FIREBASE_PROJECT_ID=studio-7488920972-4ef9c
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@xxxxx.iam.gserviceaccount.com

# Preferred on Cloud Run: attach a service account with Firebase/Firestore permissions
# and leave FIREBASE_USE_SERVICE_ACCOUNT_KEY unset (ADC is used automatically).
# FIREBASE_USE_ADC=true
# FIREBASE_USE_SERVICE_ACCOUNT_KEY=true

# Alternative: paste the full downloaded service account JSON as one line
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}

# Alternative: base64-encoded service account JSON (avoids newline corruption)
# FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo

# Server Configuration
PORT=3000
NODE_ENV=development
