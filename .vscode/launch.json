{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "leox (Android)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--no-enable-impeller"
            ]
        },
        {
            "name": "Web Admin Panel (Chrome)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}/web_admin",
            "args": [
                "-d",
                "chrome",
                "--web-renderer",
                "html"
            ]
        },
        {
            "name": "Web Admin (Local Web Server)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}/web_admin",
            "args": [
                "-d",
                "web-server",
                "--web-port",
                "8080",
                "--web-hostname",
                "localhost"
            ]
        },
        {
            "name": "Node.js Backend",
            "request": "launch",
            "type": "node",
            "program": "${workspaceFolder}/backend/server.js",
            "cwd": "${workspaceFolder}/backend"
        }
    ],
    "compounds": [
        {
            "name": "LEO OPUS Full Stack",
            "configurations": [
                "Node.js Backend",
                "leox (Android)",
                "Web Admin Panel (Chrome)"
            ]
        }
    ]
}