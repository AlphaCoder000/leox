{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "leox (Android)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--no-enable-impeller",
            ]
        },
        {
            "name": "leox (Chrome)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "chrome",
                "--web-renderer",
                "html"
            ]
        },
        {
            "name": "leox (Windows)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "windows"
            ]
        }
    ]
}