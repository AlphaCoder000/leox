rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user has employer role in token or users collection
    // This is robust to support both web app pattern and mobile app pattern
    function isEmployer() {
       return isAuthenticated() && (
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employer') ||
         (exists(/databases/$(database)/documents/employers/$(request.auth.uid)))
       );
    }

    // --- USERS COLLECTION (Web App compatibility) ---
    match /users/{userId} {
      allow read, write: if request.auth != null
                           && request.auth.uid == userId;

      match /notifications/{notificationId} {
        allow read, write: if request.auth != null
                             && request.auth.uid == userId;
      }
    }
    
    // --- EMPLOYERS COLLECTION ---
    match /employers/{userId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated(); // Allow listing employers
      allow create, update, delete: if isOwner(userId);
      
      // Subcollection for applications
      match /applications/{docId} {
        // Employers manage their own list
        allow read, update, delete: if isOwner(userId);
        // Authenticated employees can submit applications
        allow create: if isAuthenticated();
      }
    }

    // --- EMPLOYEES COLLECTION ---
    match /employees/{userId} {
      allow get: if isAuthenticated();
      allow list: if isEmployer(); // Only employers can list candidates
      allow create, update, delete: if isOwner(userId);
      
      // Subcollection for applications
      match /applications/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- JOBS COLLECTION ---
    match /jobs/{jobId} {
      // Anyone can read jobs (or restrict to authenticated if preferred)
      allow read: if true;
      
      // Only employers can create jobs
      allow create: if isEmployer();
      
      // Only the job owner (employer) can update/delete
      // Note: We check both 'employerId' field and 'postedBy' field for robustness
      allow update, delete: if isEmployer() && (
        resource.data.employerId == request.auth.uid || 
        resource.data.postedBy == request.auth.uid ||
        resource.data.postedBy == request.auth.token.email // Legacy support if using email
      );
    }

    // --- APPLICATIONS COLLECTION (Global Access for Employees/Employers) ---
    match /applications/{allPaths=**} {
      allow read, write: if isAuthenticated();
    }
    
    // --- CANDIDATES COLLECTION (Global Access for Employees/Employers) ---
    match /candidates/{allPaths=**} {
      allow read, write: if isAuthenticated();
    }
    
    // --- NOTIFICATIONS COLLECTION ---
    match /notifications/{notificationId} {
      // Allows users to view notifications (Query should filter by userId)
      allow read: if isAuthenticated();
      
      // Allow any authenticated user to create a notification
      allow create: if isAuthenticated();
      
      // Users can only update (mark as read) or delete their own notifications
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // --- MAINTENANCE CONTRACTS COLLECTIONS ---
    match /mc_providers/{userId} {
      allow read: if isAuthenticated(); // Needed by main router and seekers
      allow create, delete: if isOwner(userId);
      allow update: if isAuthenticated() && (
        isOwner(userId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating'])
      );
    }
    
    match /mc_seekers/{userId} {
      allow read: if isAuthenticated(); // Needed by main router
      allow write: if isOwner(userId);
    }
    
    match /mc_services/{serviceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Allow providers to manage their services
    }
    
    match /mc_requests/{requestId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Allow seekers to book, providers to update status
    }
    
    match /mc_reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // Allow seekers to create reviews
      allow update: if isAuthenticated(); // Allow users to update their own reviews
      allow delete: if request.auth.uid == resource.data.seekerId; // Users can only delete their own reviews
    }

    // --- STORAGE RULES (If applicable here, though this is firestore.rules) ---
    // Note: Storage rules are separate.
  }
}
