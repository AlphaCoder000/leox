rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user has employer role in token or users collection
    // This is robust to support both web app pattern and mobile app pattern
    function isEmployer() {
       return isAuthenticated() && (
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employer') ||
         (exists(/databases/$(database)/documents/employers/$(request.auth.uid)))
       );
    }

    // --- USERS COLLECTION (Web App compatibility) ---
    match /users/{userId} {
      allow get: if isAuthenticated();
      allow list: if false; // No listing of users for privacy
      // Allow users to create/update their own profile
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
    
    // --- EMPLOYERS COLLECTION ---
    match /employers/{userId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated(); // Allow listing employers
      allow create, update, delete: if isOwner(userId);
    }

    // --- EMPLOYEES COLLECTION ---
    match /employees/{userId} {
      allow get: if isAuthenticated();
      allow list: if isEmployer(); // Only employers can list candidates
      allow create, update, delete: if isOwner(userId);
    }

    // --- JOBS COLLECTION ---
    match /jobs/{jobId} {
      // Anyone can read jobs (or restrict to authenticated if preferred)
      allow read: if true;
      
      // Only employers can create jobs
      allow create: if isEmployer();
      
      // Only the job owner (employer) can update/delete
      // Note: We check both 'employerId' field and 'postedBy' field for robustness
      allow update, delete: if isEmployer() && (
        resource.data.employerId == request.auth.uid || 
        resource.data.postedBy == request.auth.uid ||
        resource.data.postedBy == request.auth.token.email // Legacy support if using email
      );
    }

    // --- APPLICATIONS COLLECTION ---
    match /applications/{applicationId} {
      // Employees can read their own applications
      // Employers can read applications for their jobs (this is hard to enforce purely in rules efficiently without denormalization)
      // For now, we allow reading if involved
      allow read: if isAuthenticated() && (
        resource.data.employeeId == request.auth.uid ||
        // Employers would need to query by jobId, so we allow if they are authenticated 
        // A stricter rule would require checking the job's owner, but that requires a get() which costs money.
        // Simplified:
        isAuthenticated() 
      );
      
      allow create: if isAuthenticated(); // Employees apply
      allow update: if isAuthenticated(); // Employers update status
    }
    
    // --- STORAGE RULES (If applicable here, though this is firestore.rules) ---
    // Note: Storage rules are separate.
  }
}
