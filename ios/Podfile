# iOS Podfile configured for Leox

platform :ios, '13.0'

# Read the Flutter SDK root path from the generated configuration file
flutter_root = nil
File.foreach(File.join(File.dirname(__FILE__), 'Flutter', 'Generated.xcconfig')) do |line|
  matches = line.match(/FLUTTER_ROOT=(.*)/)
  flutter_root = matches[1] if matches
end

raise "FLUTTER_ROOT not found in Generated.xcconfig. Run 'flutter pub get' first." if flutter_root.nil?

# Require the helper script from the Flutter SDK directly
require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

pre_install do |installer|
  # Bypass CocoaPods validation check for static framework transitive dependencies (fixing razorpay_flutter crash)
  Pod::Installer::Xcode::TargetValidator.send(:define_method, :verify_no_static_framework_transitive_dependencies) {}
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.expand_path(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    # 1. Force deployment target to 13.0 and allow non-modular includes to fix Firebase compiler issues
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
    end
    
    # 2. Fix for BoringSSL-GRPC compiler flag compatibility issue with Xcode 16+
    if target.name == 'BoringSSL-GRPC'
      source_build_phase = target.respond_to?(:source_build_phase) ? target.source_build_phase : nil
      if source_build_phase && source_build_phase.respond_to?(:files) && source_build_phase.files
        source_build_phase.files.each do |file|
          if file.settings && file.settings['COMPILER_FLAGS']
            flags = file.settings['COMPILER_FLAGS'].split
            flags.reject! { |flag| flag == '-GCC_WARN_INHIBIT_ALL_WARNINGS' }
            file.settings['COMPILER_FLAGS'] = flags.join(' ')
          end
        end
      end
    end
  end
end
